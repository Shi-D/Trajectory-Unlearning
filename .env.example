# Copy to .env (loaded by every launcher in examples/traj_trainer/).

# Directory holding base models (Traj-AlfWorld-3B, Webshop-7B-RL) and checkpoints (ckpt/).
MODELS_ROOT=/path/to/models
# Optional overrides (defaults shown):
# CKPT_ROOT=$MODELS_ROOT/ckpt
# ALFWORLD_BASE_MODEL=$MODELS_ROOT/Traj-AlfWorld-3B
# WEBSHOP_BASE_MODEL=$MODELS_ROOT/Webshop-7B-RL
# COLLECTION_DIR=<repo>/collection
# COLLECTION_WEBSHOP_DIR=<repo>/collection_webshop
# CONDA_ENV=traj

# ALFWorld data (alfworld-download default location).
ALFWORLD_DATA=$HOME/.cache/alfworld

# Only needed when trajectory analysis uses an OpenAI-compatible backend.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
